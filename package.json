{
  "name": "cited",
  "version": "0.1.0",
  "private": true,
  "description": "Cited, by Katalis: a business answers with its own documents.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:widget": "node scripts/build-widget.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ingest": "node --env-file-if-exists=.env scripts/ingest.ts",
    "search": "node --env-file-if-exists=.env scripts/search.ts",
    "ask": "node --env-file-if-exists=.env scripts/ask.ts",
    "audit:high": "npm audit --audit-level=high",
    "secrets:scan": "gitleaks git --redact --no-banner",
    "hooks:install": "node scripts/install-hooks.mjs",
    "openspec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.68",
    "@ai-sdk/deepseek": "^3.0.56",
    "@ai-sdk/google": "^4.0.85",
    "@ai-sdk/groq": "^4.0.52",
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@libsql/client": "^0.18.0",
    "ai": "^7.0.122",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
