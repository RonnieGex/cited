# Environment files: every real environment file stays out of the repository.
# Only the template with empty values is versioned.
.env*
!.env.example

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/out/
/build

# Tests and coverage
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# Generated types
next-env.d.ts
*.tsbuildinfo

# Logs and local tooling
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
*.pem
.idea
.vscode/*
!.vscode/extensions.json
.vercel
.dockerignore.local
