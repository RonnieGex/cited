# Cited, by Katalis - environment template.
# Copy this file to .env and fill in the values. Every value here is empty on purpose.
# No key is ever committed, logged or sent to the browser.

# Required. Password of the administration panel, at least 16 characters. Without it, or with a shorter one, the panel
# does not start.
ADMIN_PASSWORD=

# Required. Secret used to sign the administration session cookie.
ADMIN_SESSION_SECRET=

# Required. Secret that the voice agent tool expects in its Bearer token.
VOICE_TOOL_SECRET=

# The keys the owner saves in the panel. ENCRYPTION_KEY is what encrypts them: 32 bytes in base64, generated once with
# `openssl rand -base64 32`. Without it the panel stores no key and says why, and nothing falls back to plain text.
# Changing it leaves the keys already saved unreadable, and the panel asks for them again.
# PROVIDER_TEST_TIMEOUT_MS is how long the test of a provider waits before it says the provider took too long; 10000 ms
# (ten seconds) by default.
ENCRYPTION_KEY=
PROVIDER_TEST_TIMEOUT_MS=

# Model providers. Fill the one you use; the rest can stay empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
LMSTUDIO_BASE_URL=

# The address of a provider. Optional: point a provider at a compatible endpoint of your own (a gateway, a proxy, a
# server on the same machine). An empty value keeps the address the provider publishes.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=
DEEPSEEK_BASE_URL=
GROQ_BASE_URL=
OPENROUTER_BASE_URL=

# The chat provider of the answers. CHAT_PROVIDER is one of openai, anthropic, gemini, deepseek, groq,
# openrouter, ollama, lmstudio or fake. Each one needs the key above with its name, except ollama and lmstudio
# (local, no key) and fake (deterministic, offline, no key: the provider of the tests and of a first run).
# A missing key answers 503 naming the variable, never its value.
CHAT_PROVIDER=

# Model and embedding selection. CHAT_MODEL is optional: without it the provider uses its own default model.
CHAT_MODEL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Embeddings of the knowledge search. EMBEDDINGS_PROVIDER is one of openai, ollama or fake.
# openai is any OpenAI-compatible embeddings API and needs base URL, model and key.
# ollama needs a base URL and a model. fake is deterministic, offline and for tests only.
# EMBEDDINGS_DIMENSIONS is optional; it overrides the default of the chosen provider.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSIONS=

# Database. A local file, or Turso in the cloud with the same code.
# DATABASE_URL is the local file (default .data/katalis.sqlite). TURSO_DATABASE_URL wins over it.
# TURSO_AUTH_TOKEN is required when the URL is remote (libsql://, https:// or wss://); a local file needs none.
DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ElevenLabs voice agent. Optional; the app works without it.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Spending limits and abuse protection. The defaults: MAX_QUESTION_CHARS 1000 characters per question,
# RATE_LIMIT_PER_IP_PER_HOUR 30 questions per address, DAILY_MODEL_CALL_LIMIT 500 model calls per UTC day,
# MAX_ANSWER_TOKENS 600 tokens per answer. An empty, zero, negative or non-integer value keeps its default.
MAX_QUESTION_CHARS=
RATE_LIMIT_PER_IP_PER_HOUR=
DAILY_MODEL_CALL_LIMIT=
DAILY_VOICE_MINUTE_LIMIT=
MAX_ANSWER_TOKENS=

# Privacy. CONVERSATION_RETENTION_DAYS is 30 by default: the turns older than that are purged.
CONVERSATION_RETENTION_DAYS=

# The links and the offer of the panel. AFFILIATE_LINKS=off turns every affiliate link of the provider catalogue into
# its plain link and hides the "(paid link)" label; any other value keeps them. HOSTED_OFFER_URL is the address of the
# hosted version of Katalis, which the panel offers under the list of providers; an empty value hides the offer.
AFFILIATE_LINKS=
HOSTED_OFFER_URL=

# The address of the visitor. TRUST_PROXY is the number of proxies in front of the application: 1 for Traefik alone,
# 2 for a CDN in front of Traefik. With it the address is that many places from the right of x-forwarded-for, the one
# the outermost trusted proxy received the request from, or x-real-ip when the chain is shorter. Without it the
# forwarding headers are ignored, because a client can write them, and every direct visitor shares one bucket. In
# every case the address is stored only as a salted hash.
TRUST_PROXY=

# Allowed origins for the embeddable widget, comma separated.
ALLOWED_ORIGINS=
