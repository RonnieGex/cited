# Katalis Responde Community - environment template.
# Copy this file to .env and fill in the values. Every value here is empty on purpose.
# No key is ever committed, logged or sent to the browser.

# Required. Password of the administration panel. Without it the panel does not start.
ADMIN_PASSWORD=

# Required. Secret used to sign the administration session cookie.
ADMIN_SESSION_SECRET=

# Required. Secret that the voice agent tool expects in its Bearer token.
VOICE_TOOL_SECRET=

# Model providers. Fill the one you use; the rest can stay empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
LMSTUDIO_BASE_URL=

# Model and embedding selection.
CHAT_MODEL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Embeddings of the knowledge search. EMBEDDINGS_PROVIDER is one of openai, ollama or fake.
# openai is any OpenAI-compatible embeddings API and needs base URL, model and key.
# ollama needs a base URL and a model. fake is deterministic, offline and for tests only.
# EMBEDDINGS_DIMENSIONS is optional; it overrides the default of the chosen provider.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSIONS=

# Database. A local file, or Turso in the cloud with the same code.
# DATABASE_URL is the local file (default .data/katalis.sqlite). TURSO_DATABASE_URL wins over it.
DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ElevenLabs voice agent. Optional; the app works without it.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Spending limits and abuse protection.
MAX_QUESTION_CHARS=
RATE_LIMIT_PER_IP_PER_HOUR=
DAILY_MODEL_CALL_LIMIT=
DAILY_VOICE_MINUTE_LIMIT=
MAX_ANSWER_TOKENS=

# Privacy.
CONVERSATION_RETENTION_DAYS=

# Allowed origins for the embeddable widget, comma separated.
ALLOWED_ORIGINS=
